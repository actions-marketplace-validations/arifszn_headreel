{
  "name": "headreel",
  "version": "0.0.0",
  "description": "Animated GitHub profile banners from your GitHub data.",
  "license": "MIT",
  "author": "Ariful Alam",
  "type": "module",
  "bin": {
    "headreel": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "assets"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "dev": "tsx src/cli/index.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.9",
    "gifenc": "1.0.3",
    "jsdom": "30.1.0",
    "p5": "2.3.2",
    "sharp": "0.35.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/node": "22.20.3",
    "oxlint": "1.83.0",
    "prettier": "3.9.8",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
